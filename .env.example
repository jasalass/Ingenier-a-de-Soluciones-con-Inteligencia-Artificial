# =====================================================================
# Configuración de APIs — Ingeniería de Soluciones con IA
# Copia este archivo a `.env` y completa las keys.
# Todos los servicios usados son GRATIS.
# =====================================================================

# --- Chat / LLM: Mistral ----------------------------------------------
# API compatible con OpenAI, por eso el código usa el cliente `OpenAI`.
# Obtén tu key gratuita en: https://console.mistral.ai/api-keys
# (pide verificar un número de teléfono una sola vez)
LLM_BASE_URL="https://api.mistral.ai/v1"
LLM_API_KEY=""
LLM_MODEL="mistral-small-latest"
LLM_MODEL_SMALL="ministral-8b-latest"

# --- Respaldo: Groq ---------------------------------------------------
# Si te quedas sin cuota de Mistral, comenta las 4 líneas de arriba y
# descomenta estas. Key gratuita en: https://console.groq.com/keys
#
# ⚠️ Groq retiró los modelos Llama de su catálogo gratuito. Lo que queda son
# modelos de razonamiento: gastan parte del presupuesto de `max_tokens` en
# razonamiento interno que no ves, así que con valores muy bajos (≤10) pueden
# devolver una respuesta vacía. Los ejercicios ya usan valores seguros.
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_API_KEY=""
# LLM_MODEL="openai/gpt-oss-120b"
# LLM_MODEL_SMALL="openai/gpt-oss-20b"

# --- Embeddings: Google AI Studio (Gemini) ----------------------------
# Ni Mistral ni Groq se usan aquí: el pipeline de RAG está validado con Gemini.
# Basta la cuenta de Google que ya usas para Colab.
# Obtén tu key en: https://aistudio.google.com/apikey
GOOGLE_API_KEY=""

# --- Observabilidad: LangSmith (opcional, RA1/IL1.4 y RA3) ------------
# Obtén tu key en: https://smith.langchain.com/settings
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ingenieria-soluciones-ia"
